{
  "name": "ipld-hashmap",
  "version": "3.1.11",
  "description": "A JavaScript implementation of the IPLD HashMap specification",
  "main": "ipld-hashmap.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./ipld-hashmap.js",
      "types": "./types/ipld-hashmap.d.ts"
    }
  },
  "types": "types/ipld-hashmap.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "standard",
    "test:node": "mocha test/*-test.js",
    "test:browser": "polendina --page --worker --serviceworker --cleanup test/*-test.js",
    "test": "npm run lint && npm run build:types && npm run test:node && npm run test:browser",
    "build": "npm run docs && npm run build:types",
    "build:types": "tsc --build",
    "docs": "jsdoc4readme --readme ipld-hashmap.js",
    "prepublishOnly": "npm run build",
    "schema-validator": "npm_config_yes=true npx ipld-schema-validator to-js hashmap.ipldsch  > schema-validate.js"
  },
  "author": "Rod <rod@vagg.org> (http://r.va.gg/)",
  "license": "Apache-2.0",
  "dependencies": {
    "iamap": "^5.1.1",
    "ipld-schema": "^3.0.3",
    "ipld-schema-describer": "^3.0.21",
    "multiformats": "^14.0.0"
  },
  "devDependencies": {
    "@ipld/dag-cbor": "^10.0.1",
    "@rvagg/chai-as-promised": "^8.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "chai": "^6.2.2",
    "conventional-changelog-conventionalcommits": "^10.0.0",
    "jsdoc4readme": "^1.4.0",
    "mocha": "^11.7.5",
    "polendina": "^3.2.22",
    "semantic-release": "^25.0.3",
    "standard": "^17.1.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rvagg/js-ipld-hashmap.git"
  },
  "typesVersions": {
    "*": {
      "*": [
        "types/*"
      ],
      "types/*": [
        "types/*"
      ]
    }
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "revert": true,
              "release": "patch"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "scope": "no-release",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "chore",
                "section": "Trivial Changes"
              },
              {
                "type": "docs",
                "section": "Trivial Changes"
              },
              {
                "type": "test",
                "section": "Tests"
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
